  "config": {
    "step": {
      "user": {
        "title": "Connect a Keenetic router",
        "description": "Enter the RCI address and port. For unauthenticated access through a port forwarded to 127.0.0.1:79, leave username and password empty. Restrict that port to the Home Assistant address.",
        "data": {
          "address": "Router address",
          "port": "Port",
          "username": "Username",
          "password": "Password"
        }
      },
      "reauth": {
        "title": "Reauthenticate Keenetic router",
        "description": "Enter the username and password, or leave both empty for access through the forwarded RCI port.",
        "data": {
          "address": "Router address",
          "port": "Port",
          "username": "Username",
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the router.",
      "invalid_auth": "The router rejected these credentials.",
      "unsupported_response": "The host did not return a supported Keenetic RCI response.",
      "invalid_address": "Enter a valid HTTP or HTTPS address without a path.",
      "wrong_router": "These credentials connect to a different router."
    },
    "abort": {
      "already_configured": "This router is already configured.",
      "reauth_successful": "Router credentials updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Keenetic options",
        "data": {
          "scan_interval": "Polling interval (seconds)",
          "clients": "Selected clients",
          "policy_clients": "Clients with policy selectors",
          "allow_mutating_rci": "Allow arbitrary RCI POST requests",
          "wifi_enabled_access_points": "Enabled Wi-Fi networks",
          "sms_target": "Default SMS recipient"
        },
        "data_description": {
          "clients": "Select discovered clients or enter MAC addresses manually.",
          "policy_clients": "Independent list of clients that need an IP-policy control.",
          "allow_mutating_rci": "Advanced option. POST may change router configuration or start commands.",
          "wifi_enabled_access_points": "Select the networks that should remain enabled. Unselected networks will be turned off when you save."
        }
      }
    },
    "error": {
      "invalid_mac": "Enter client MAC addresses as aa:bb:cc:dd:ee:ff.",
      "wifi_update_failed": "Could not change Wi-Fi state. Check the router connection and try again."
    }
  },
  "services": {
    "request_api": {
      "name": "Request RCI API",
      "description": "Select one router device or provide entry_id. GET reads data. POST requires the advanced integration option and can change router configuration.",
      "fields": {
        "device_id": {"name": "Router device"},
        "entry_id": {"name": "Config entry ID"},
        "method": {"name": "Method"},
        "endpoint": {"name": "RCI endpoint"},
        "data_json": {"name": "JSON request data"}
      }
    },
    "list_sms": {
      "name": "List SMS",
      "description": "Select exactly one Keenetic modem. Returns messages without changing their read state.",
      "fields": {
        "device_id": {"name": "Modem"}
      }
    },
    "mark_sms_read": {
      "name": "Mark SMS as read",
      "description": "Select exactly one Keenetic modem. Marks one SMS as read using an ID from the message list.",
      "fields": {
        "device_id": {"name": "Modem"},
        "sms_id": {"name": "SMS ID"}
      }
    },
    "delete_sms": {
      "name": "Delete SMS",
      "description": "Select exactly one Keenetic modem. Deletes one SMS using an ID from the message list.",
      "fields": {
        "device_id": {"name": "Modem"},
        "sms_id": {"name": "SMS ID"}
      }
    },
    "send_ussd": {
      "name": "Send USSD request",
      "description": "Select exactly one Keenetic modem. Waits up to 60 seconds for a reply. Only one USSD request can run per router at a time.",
      "fields": {
        "device_id": {"name": "Modem"},
        "request": {"name": "USSD request"}
      }
    },
    "send_sms": {
      "name": "Send SMS",
      "description": "Select exactly one SMS-capable Keenetic modem. Sends to one recipient; an empty field uses the phone number from the integration options.",
      "fields": {
        "device_id": {"name": "Modem"},
        "message": {"name": "Message"},
        "recipient": {"name": "Recipient", "description": "One number: digits and an optional leading +. Add separate send SMS actions for multiple recipients."}
      }
    }
  },
  "exceptions": {
    "ussd_busy": {"message": "A USSD request is already running on this router. Wait for it to finish."},
    "sms_recipient_missing": {"message": "Set an SMS recipient or configure the default phone number in the integration options."},
    "sms_recipient_invalid": {"message": "Enter one phone number using digits and an optional leading +."},
    "sms_id_required": {"message": "Enter one message ID returned by list_sms."},
    "sms_not_found": {"message": "The SMS ID does not exist on the selected modem."},
    "sms_change_unconfirmed": {"message": "The SMS change is not confirmed. Check the message list before calling the action again."}
  },
